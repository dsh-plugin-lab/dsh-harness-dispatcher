# Dependencies
node_modules/

# Build output (produced by the build command; shipped through the `files` field).
# WARNING: keep this anchored to the repository root. A bare `lib/` matches at **any depth**,
# so it also ignores `src/lib/` — in this repository's layout that would be source code, and the
# symptom is silent: green locally, missing files in CI's clean clone.
/lib/
*.tsbuildinfo

# Test and coverage artifacts
coverage/
.vitest/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local backups and scratch files
*.bak-*
*.orig
*.rej

# Local credentials: never commit these
.env
.env.*

# Benchmark output directories created by a manual run
/runs/
