# Dependencies
node_modules/

# Build output (produced by the build command; shipped through the `files` field)
# WARNING: this must stay anchored to the repository root. A bare `lib/` matches at **any depth**, so
# it also ignores `src/lib/`. The symptom is silent: green locally, missing files in CI's clone.
/lib/
*.tsbuildinfo

# Tests and coverage
coverage/
.vitest/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local backups and scratch files
*.bak-*
*.orig
*.rej

# Local credentials: never commit these
.env
.env.*
*.local.yml
