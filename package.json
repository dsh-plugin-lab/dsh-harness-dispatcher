{
  "name": "dsh-harness-dispatcher",
  "version": "0.1.0",
  "description": "Score the agent harness, not the model: run fixed tasks against controlled harness variants and record deterministic traces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugin-lab/dsh-harness-dispatcher.git"
  },
  "bugs": {
    "url": "https://github.com/dsh-plugin-lab/dsh-harness-dispatcher/issues"
  },
  "homepage": "https://github.com/dsh-plugin-lab/dsh-harness-dispatcher#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "benchmark",
    "evaluation",
    "harness"
  ],
  "license": "MIT",
  "author": "zlZayn",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:release": "node scripts/check-release.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run check:release"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
